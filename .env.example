# LLM (required for real extract/review narrative; demo works without)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Defaults when strategy .md omits values
DEFAULT_CAPITAL_INR=500000
DEFAULT_MAX_LOTS=2
MAX_SCENARIO_COMBOS=24

# Indian options cost profile (defaults)
BROKERAGE_PER_ORDER=20
STT_PCT=0.0005
EXCHANGE_TXN_PCT=0.0003503
GST_PCT=0.18
SEBI_PER_CRORE=10
STAMP_DUTY_PCT=0.00003
SLIPPAGE_BPS=5

# Database (SQLite file relative to backend/; Postgres example:
# postgresql+psycopg://user:pass@localhost:5432/genesis)
DATABASE_URL=sqlite:///data/genesis.db
# Paper/live trading database (migrate with: uv run alembic -n live upgrade head)
LIVE_DATABASE_URL=sqlite:///data/genesis_live.db

# Trade Crew
PORTFOLIO_MAX_OPEN_POSITIONS=3
PORTFOLIO_MAX_DAILY_LOSS_INR=10000
# Every deployment pauses at this drawdown from peak equity, whatever its own ladder says (0 disables)
MAX_DRAWDOWN_PCT=20
LOT_SIZES=NIFTY:75,BANKNIFTY:35
STRIKE_STEPS=NIFTY:50,BANKNIFTY:100
MAX_SNAPSHOT_AGE_SECONDS=120
TRADE_CREW_EXPLAIN=false

# Imported NSE end-of-day data, events and news (reference data, not audited)
MARKET_DATABASE_URL=sqlite:///data/market_eod.db
IV_RANK_LOOKBACK_DAYS=252
EVENT_LOOKAHEAD_DAYS=14
NEWS_LOOKBACK_HOURS=24
# NEWS_FEEDS=name=url,name=url

# LLM trade opinion: off | shadow | veto (veto is also enabled per deployment, with evidence)
LLM_TRADE_OPINION=off
# LLM_OPINION_MODEL=          # defaults to OPENAI_MODEL
LLM_OPINION_TIMEOUT_S=20
OPINION_EVAL_MIN_SAMPLES=30
OPINION_EVAL_WINDOW=50
LLM_VETO_LIVE_ALLOWED=false

BACKEND_PORT=8841
CORS_ORIGINS=http://127.0.0.1:8842
NEXT_PUBLIC_API_URL=http://127.0.0.1:8841
