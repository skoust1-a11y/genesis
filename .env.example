# LLM (required for real extract/review narrative; demo works without)
# openai | anthropic (Claude); only the chosen provider's key is needed
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Langfuse (LLM tracing; keys from Project → Settings → API Keys)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Defaults when strategy .md omits values
DEFAULT_CAPITAL_INR=50000
DEFAULT_MAX_LOTS=1
MAX_SCENARIO_COMBOS=24
# Hard stop-loss values (% of capital) each review backtests and forward-tests; empty turns the sweep off
HARD_STOP_SWEEP_PCTS=2,3,4,5

# Indian options cost profile (defaults)
BROKERAGE_PER_ORDER=20
STT_PCT=0.0005
EXCHANGE_TXN_PCT=0.0003503
GST_PCT=0.18
SEBI_PER_CRORE=10
STAMP_DUTY_PCT=0.00003
SLIPPAGE_BPS=5

# Database (SQLite file relative to backend/; Postgres example:
# postgresql+psycopg://user:pass@localhost:5432/genesis)
DATABASE_URL=sqlite:///data/genesis.db
# Paper/live trading database (migrate with: uv run alembic -n live upgrade head)
LIVE_DATABASE_URL=sqlite:///data/genesis_live.db

# Trade Crew
PORTFOLIO_MAX_OPEN_POSITIONS=2
# Two full-size losses at ₹1,500 risk per trade
PORTFOLIO_MAX_DAILY_LOSS_INR=3000
# Every deployment pauses at this drawdown from peak equity, whatever its own ladder says (0 disables)
MAX_DRAWDOWN_PCT=20
# Common risk rules for every strategy (backtests and live). A strategy's own `risk:` value applies
# only when stricter. 0 disables each rule.
MAX_ENTRIES_PER_DAY=1
# After this many losing trades in a row, no entries that day or for the next LOSS_COOLDOWN_DAYS trading days
MAX_CONSECUTIVE_LOSSES=3
LOSS_COOLDOWN_DAYS=3
# Largest loss one trade may risk, as % of capital: 100 = never more than the account (no leverage)
MAX_LOSS_PCT_OF_CAPITAL=100
# No new entries once this many trades have closed at a loss today (1 = no re-entry after a loss)
MAX_LOSSES_PER_DAY=0
# Minutes to wait after an entry or exit before the next entry (backtests: no second trade the same day)
MIN_MINUTES_BETWEEN_TRADES=0
# NSE lot sizes from the January 2026 expiries (were 75 and 35); imported bhavcopies carry their own
LOT_SIZES=NIFTY:65,BANKNIFTY:30
STRIKE_STEPS=NIFTY:50,BANKNIFTY:100
MAX_SNAPSHOT_AGE_SECONDS=120
TRADE_CREW_EXPLAIN=false

# Imported NSE end-of-day data, events and news (reference data, not audited)
MARKET_DATABASE_URL=sqlite:///data/market_eod.db
IV_RANK_LOOKBACK_DAYS=252
EVENT_LOOKAHEAD_DAYS=14
NEWS_LOOKBACK_HOURS=24
# NEWS_FEEDS=name=url,name=url

# LLM trade opinion: off | shadow | veto (veto is also enabled per deployment, with evidence)
LLM_TRADE_OPINION=off
# LLM_OPINION_MODEL=          # defaults to the LLM_PROVIDER's model
LLM_OPINION_TIMEOUT_S=20
OPINION_EVAL_MIN_SAMPLES=30
OPINION_EVAL_WINDOW=50
LLM_VETO_LIVE_ALLOWED=false

# Live trading gates (see backend/README.md "Going live")
LIVE_TRADING_ENABLED=false
LIVE_ALLOWED_STRUCTURES=iron_condor,long_call,long_put,bull_call_spread,bear_put_spread
LIVE_MIN_PAPER_DAYS=0
# Lets the simulated Sandbox broker have live accounts, to exercise the live gates without money at risk
SANDBOX_ALLOW_LIVE=false
# SANDBOX_STATE_DIR=data/sandbox

# API auth: name:sha256(token) pairs, comma-separated. Create with: uv run python -m app.auth new-token NAME
# When set, every mutating request and every /api/live read needs Authorization: Bearer <token>.
API_TOKENS=

# Broker credentials: stored encrypted in the live DB with this Fernet key (generate with
# uv run python -c "from app.brokers.credentials import generate_key; print(generate_key())"),
# else read from BROKER_<BROKER>_<FIELD>, e.g.:
BROKER_CREDENTIALS_KEY=
# BROKER_ZERODHA_API_KEY=
# BROKER_ZERODHA_ACCESS_TOKEN=

# Orders
MAX_SPREAD_PCT=5
ORDER_FILL_TIMEOUT_S=30
ORDER_POLL_INTERVAL_S=1
ORDER_REPRICE_STEPS=2
MAX_SLIPPAGE_BPS=100
ORDER_EXIT_RETRIES=2
# 0 = no cap on a single order's value
MAX_ORDER_VALUE_INR=0
MAX_ORDERS_PER_MINUTE=120
FREEZE_QUANTITIES=NIFTY:1800,BANKNIFTY:900

# NSE session (IST); holidays in backend/data/holidays/nse.yaml
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# Broker-side protective stop-limit orders on short legs: off | live | always
PROTECTIVE_STOPS=live
PROTECTIVE_STOP_MULTIPLIER=1.5
PROTECTIVE_STOP_LIMIT_BUFFER_PCT=5
# Available margin must be at least required margin times this
MARGIN_BUFFER=1.2
# A started deployment with no Trade Crew tick for this long is "crew not running" (and alerts)
HEARTBEAT_MAX_AGE_S=180

# Alerts (halt, pause, reconciliation mismatch, protective stop fired, missed heartbeat, crashes)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=
ALERT_SMTP_TO=

BACKEND_PORT=8841
CORS_ORIGINS=http://127.0.0.1:8842
NEXT_PUBLIC_API_URL=http://127.0.0.1:8841
