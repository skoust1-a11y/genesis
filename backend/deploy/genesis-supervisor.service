# systemd unit for the Trade Crew supervisor (Linux).
# Edit User and WorkingDirectory, then:
#   sudo cp deploy/genesis-supervisor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now genesis-supervisor
#   journalctl -u genesis-supervisor -f
# Crew logs: DATA_DIR/logs/crew-<deployment id>.log
[Unit]
Description=Genesis Trade Crew supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genesis
WorkingDirectory=/opt/genesis/backend
EnvironmentFile=/opt/genesis/backend/.env
ExecStart=/usr/bin/env uv run python -m app.live supervise --feed broker --interval 60
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
